# Copie para .env e preencha. Os quatro primeiros são obrigatórios — sem eles o
# worker não sobe. Todos saem do .env.local do painel (repo social-hub).

# Postgres do Supabase. Use a string do POOLER (porta 6543), não a direta:
# o worker abre conexão longa e o pooler é quem aguenta isso.
DATABASE_URL=

# Storage do Supabase — é onde clipes, frames e composto são hospedados.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# WaveSpeed: gera vídeo (Kling/Wan/MiniMax), imagem (Seedream), transcrição
# (Whisper) E o texto (Kimi K3, em llm.wavespeed.ai). Uma chave só para tudo.
WAVESPEED_API_KEY=

# --- daqui pra baixo é opcional; os padrões são bons ---

# Porta da API de saúde (/saude e /status).
PORT=8080

# De quanto em quanto tempo procura trabalho novo, em ms.
WORKER_POLL_MS=5000

# De quanto em quanto tempo bate o ponto, em ms. É esse sinal que faz o painel
# dizer "worker de pé"; ficando maior que ~60s, a tela passa a dar falso alarme.
WORKER_HEARTBEAT_MS=15000

# Minutos até um job travado ser considerado abandonado e poder ser retomado.
# Um clipe do Kling leva minutos: encurtar isso faz dois workers pegarem o mesmo
# job e pagarem a geração duas vezes.
WORKER_LEASE_MIN=20

# Teto de wall-clock por processo externo (ffmpeg, python), em ms. O maior
# render legítimo medido levou 7 segundos; isto existe para o caso patológico,
# em que um filtro não converge e queima CPU indefinidamente.
WORKER_EXEC_TIMEOUT_MS=600000
